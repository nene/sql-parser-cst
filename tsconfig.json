{
  "compilerOptions": {
    "module": "NodeNext",
    "types": ["node", "jest"],
    "target": "es6",
    "lib": ["es6"],
    "rootDirs": ["src"],
    "paths": { "src/*": ["./src/*"] },
    "declaration": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src", "test", "perf", "scripts"],
  "exclude": ["node_modules"]
}
